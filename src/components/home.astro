---
import { Icon } from 'astro-icon/components';
import localData from '../data/home.json';
import { resolveAssetImage } from '../utils/images';
import { Image } from 'astro:assets';

// Data definitions
interface Social {
  name: string;
  url: string;
  icon: string;
}

interface ProfileData {
  name: string;
  photoUrl?: string;
  intro: string;
  introHtml?: string;
  resumeUrl?: string;
  socials?: Social[];
}

const isApiLive = import.meta.env.PROD;
const BASE_URL = import.meta.env.PUBLIC_API_BASE_URL;

let data: ProfileData;

if (isApiLive && BASE_URL) {
  try {
    const response = await fetch(`${BASE_URL}/home`);
    if (!response.ok) throw new Error('Network response was not ok');
    data = (await response.json()) as ProfileData;
  } catch (error) {
    console.error('API Fetch failed, falling back to mock data', error);
    data = localData as unknown as ProfileData;
  }
} else {
  data = localData as unknown as ProfileData;
}

const { name, photoUrl, intro, introHtml, resumeUrl, socials = [] } = data;
const introContent = introHtml || intro || '';
const profileImage = await resolveAssetImage(photoUrl || '');
const safeResumeUrl = resumeUrl && resumeUrl !== '#' && resumeUrl !== '' ? resumeUrl : undefined;
const filteredSocials = socials.filter((social) => social?.url && social.url !== '#' && social.url !== '');
---

<section id="home" class="flex min-h-[80vh] flex-col items-center justify-center gap-1 section-container text-center md:pt-30">
  <div class="reveal-content group relative mb-2" style="animation-delay: 100ms;">
    <div class="balloon-float h-20 w-20 overflow-hidden rounded-full border-2 border-accent shadow-[0_0_50px_color-mix(in_srgb,var(--color-accent)_33%,transparent)] md:h-54 md:w-54">
      {profileImage ? (
        <Image
          src={profileImage}
          alt={name}
          class="h-full w-full scale-110 object-cover"
          loading="eager"
        />
      ) : (
        <img
          src={photoUrl || '/id0.png'}
          alt={name}
          class="h-full w-full scale-110 object-cover"
          loading="eager"
        />
      )}
    </div>
    <div class="balloon-float absolute -z-10 left-0 top-0 h-full w-full rounded-full bg-accent opacity-20 blur-[80px]"></div>
  </div>

  <div class="reveal-content relative z-0 mx-auto max-w-360 px-6 sm:px-14 md:px-18 lg:px-40" style="animation-delay: 300ms;">
    <h1 class="font-heading text-5xl font-bold tracking-tight text-maintext md:text-7xl">
      {name}
    </h1>
    <br />
    <p class="font-body text-lg leading-relaxed text-gray" set:html={introContent} />
  </div>

  <div class="reveal-content mt-8 mb-4" style="animation-delay: 400ms;">
    <a
      href={safeResumeUrl || '#'}
      target="_blank"
      rel="noopener noreferrer"
      class="group relative inline-flex items-center justify-center rounded-full border border-accent/50 bg-accent/10 px-10 py-2 text-maintext font-body shadow-[0_0_20px_rgba(var(--accent-rgb),0.3)] transition-all duration-300 hover:scale-105 md:shadow-none md:hover:border-accent/50 md:hover:bg-accent/10 md:hover:shadow-[0_0_20px_rgba(var(--accent-rgb),0.3)]"
    >
      <div class="flex flex-col items-center justify-center text-center">
        <span class="text-sm font-medium tracking-wide transition-transform duration-300 md:translate-y-2 md:text-base md:group-hover:translate-y-0">
          Ver Resumen
        </span>

        <span class="whitespace-nowrap text-[10px] font-light text-subtext opacity-100 translate-y-0 transition-all duration-300 md:opacity-0 md:translate-y-1 md:group-hover:opacity-100 md:group-hover:translate-y-0">
          Descargar documento PDF
        </span>
      </div>

      <div class="absolute inset-0 -z-10 rounded-full bg-accent/20 opacity-100 blur-md transition-opacity duration-500 md:opacity-0 md:group-hover:opacity-100"></div>
    </a>
  </div>

  <div class="reveal-content mt-4 flex gap-6" style="animation-delay: 500ms;">
    {filteredSocials.map((social) => (
        <a
          href={social.url}
          target="_blank"
          class="group relative flex flex-col items-center justify-center transition-all duration-300 hover:scale-110"
        >
          <Icon
            name={social.icon}
            class="h-8 w-8 text-maintext transition-colors duration-300 group-hover:text-accent"
          />

          <span class="absolute -bottom-6 scale-0 text-xs text-accent opacity-0 transition-all duration-300 group-hover:scale-100 group-hover:opacity-100 font-body">
            {social.name}
          </span>
        </a>
      ))}
  </div>
</section>

<style is:global>
  .reveal-content {
    opacity: 0;
    transform: translateY(20px);
    animation: revealIn 0.8s cubic-bezier(0.2, 0.8, 0.2, 1) forwards;
  }

  @keyframes revealIn {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .avatar-container {
    animation: float 5s ease-in-out infinite alternate, wobble 7s ease-in-out infinite alternate;
  }

  .balloon-float {
    will-change: transform;
    animation: floating-balloon 8s ease-in-out infinite;
  }

  @keyframes floating-balloon {
    0% {
      transform: translate(0, 0) rotate(0deg);
    }
    33% {
      transform: translate(3px, -8px) rotate(1deg);
    }
    66% {
      transform: translate(-3px, -4px) rotate(-1deg);
    }
    100% {
      transform: translate(0, 0) rotate(0deg);
    }
  }
</style>

